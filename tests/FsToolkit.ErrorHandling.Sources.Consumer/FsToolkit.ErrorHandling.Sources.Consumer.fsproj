<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <!-- The SDK warns NETSDK1138 for net8.0, which is out of support. -->
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <OtherFlags>$(OtherFlags) --warnon:21,52,1178,1182,3366,3387,3388,3389,3390,3517,3559,3560</OtherFlags>
    <FsToolkitErrorHandlingNamespace>Contoso.Internal.ErrorHandling</FsToolkitErrorHandlingNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="FsToolkit.ErrorHandling.Sources" Version="[$(FsToolkitErrorHandlingSourcesVersion)]" />
    <PackageReference Include="FsToolkit.ErrorHandling.Sources" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Async.fs" />
    <Compile Include="Library.fs" />
  </ItemGroup>
</Project>
