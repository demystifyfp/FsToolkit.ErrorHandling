<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <WebSharperProject>Spa</WebSharperProject>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <None Include="wsconfig.json" />
    <None Include="package.json" />
    <Compile Include="Runner.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Tests/FsToolkit.ErrorHandling.WebSharper.Tests.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FSharp.Core" VersionOverride="10.0.100" />
    <PackageReference Include="WebSharper" />
    <PackageReference Include="WebSharper.FSharp" />
  </ItemGroup>
</Project>
