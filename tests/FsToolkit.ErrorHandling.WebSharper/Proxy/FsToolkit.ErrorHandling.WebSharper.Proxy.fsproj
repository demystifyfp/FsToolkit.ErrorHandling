<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <WebSharperProject>Proxy</WebSharperProject>
    <DefineConstants>$(DefineConstants);FABLE_COMPILER</DefineConstants>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <None Include="wsconfig.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageVersion Include="FsToolkit.ErrorHandling.Sources" Version="$(FsToolkitErrorHandlingVersion)" />
    <PackageReference Include="FsToolkit.ErrorHandling.Sources" PrivateAssets="all" />
    <PackageReference Include="FSharp.Core" VersionOverride="6.0.4" />
    <PackageReference Include="WebSharper" />
    <PackageReference Include="WebSharper.FSharp" />
  </ItemGroup>
</Project>
